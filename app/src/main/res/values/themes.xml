<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window chrome only; all UI is drawn by Compose. Light here, dark in values-night. -->
    <style name="Theme.Halo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/halo_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Halo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/halo_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_halo</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Halo</item>
    </style>
</resources>
